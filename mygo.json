{
  "name": "FreeFolio",
  "slug": "freefolio",
  "identifier": "io.github.oubigfa.freefolio",
  "version": "0.1.1",
  "icon": "resources/icon.png",
  "main": "./cmd/freefolio",
  "out": "dist",
  "i18n": {
    "dir": "resources/locales",
    "source": "en"
  },
  "resources": [
    "LICENSE",
    "third_party",
    "internal/editor/boardfonts/Xiaolai-Regular.ttf.zlib"
  ],
  "fileAssociations": [
    {
      "ext": [
        "md",
        "markdown",
        "mdx"
      ],
      "name": "Markdown Document",
      "mimeType": "text/markdown",
      "role": "Editor"
    },
    {
      "ext": [
        "arcmd"
      ],
      "name": "Legacy Markdown Document",
      "mimeType": "application/x-arcmd",
      "role": "Editor"
    }
  ],
  "macos": {
    "icon": "resources/icon.icns"
  },
  "windows": {
    "installerInclude": "resources/installer.nsh"
  },
  "linux": {
    "webview": false
  }
}
