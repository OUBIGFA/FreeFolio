{
  "name": "FreeMD",
  "slug": "freemd",
  "identifier": "io.github.oubigfa.freemd",
  "version": "0.0.1",
  "icon": "resources/icon.png",
  "main": "./cmd/freemd",
  "out": "dist",
  "resources": [
    "LICENSE",
    "third_party"
  ],
  "fileAssociations": [
    {
      "ext": [
        "md",
        "markdown",
        "mdx"
      ],
      "name": "Markdown Document",
      "mimeType": "text/markdown",
      "role": "Editor"
    },
    {
      "ext": [
        "arcmd"
      ],
      "name": "Legacy Markdown Document",
      "mimeType": "application/x-arcmd",
      "role": "Editor"
    }
  ],
  "macos": {
    "icon": "resources/icon.icns"
  },
  "linux": {
    "webview": false
  }
}
